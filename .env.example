# Enquiry delivery for the contact, quote and proposal forms (src/app/api/{contact,quote,rfq}).
# Without these the form validates and returns a clear "not connected yet" message
# rather than silently dropping the enquiry.

# From https://resend.com — API keys.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, e.g. website@macengineers.in.
# For a quick test before the domain is verified, use onboarding@resend.dev — Resend then only
# delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL=

# Optional. Defaults to ENQUIRY_INBOX in src/data/site.ts (macengineersank@gmail.com).
CONTACT_TO_EMAIL=
